{
  "name": "simlar",
  "version": "0.13.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node --env-file .env .output/server/index.mjs",
    "db:generate": "drizzle-kit generate --config=drizzle.config.local.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.local.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.local.ts",
    "db:generate:test": "drizzle-kit generate --config=drizzle.config.test.ts",
    "db:migrate:test": "drizzle-kit migrate --config=drizzle.config.test.ts",
    "db:generate:prod": "drizzle-kit generate --config=drizzle.config.prod.ts",
    "db:migrate:prod": "drizzle-kit migrate --config=drizzle.config.prod.ts",
    "tests": "vitest run",
    "files:download": "tsx scripts/download-archivos.local.ts",
    "files:download:prod": "tsx scripts/download-archivos.prod.ts",
    "docker:build:prod": "docker build -t ghcr.io/mfpuentear/simlar:$npm_package_version .",
    "docker:push:prod": "docker push ghcr.io/mfpuentear/simlar:$npm_package_version",
    "k6:pages": "k6 run scripts/k6-carga-paginas.js",
    "k6:pages:medio": "k6 run --env NIVEL_CARGA=medio scripts/k6-carga-paginas.js",
    "k6:pages:alto": "k6 run --env NIVEL_CARGA=alto scripts/k6-carga-paginas.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
